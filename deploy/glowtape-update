#!/usr/bin/env bash
# Pull the latest main, rebuild, restart. Run as root: glowtape-update
set -euo pipefail
cd /opt/glowtape
git pull --ff-only

# Self-update: if the repo brought a newer version of this script, install it
# and re-exec so THIS run already includes the new steps.
if ! cmp -s "$0" deploy/glowtape-update; then
  install -m 0755 deploy/glowtape-update /usr/local/bin/glowtape-update
  echo "glowtape-update updated itself — re-running."
  exec /usr/local/bin/glowtape-update
fi
npm ci --no-audit --no-fund
npm run build
rm -rf backend/pb_public
mkdir -p backend/pb_public
cp -r dist/* backend/pb_public/
npm ci --no-audit --no-fund --prefix deploy/push-sender
chown -R glowtape:glowtape backend deploy/push-sender
cp deploy/Caddyfile /etc/caddy/Caddyfile
cp deploy/glowtape.service deploy/glowtape-push.service deploy/glowtape-backup.service deploy/glowtape-backup.timer /etc/systemd/system/
install -m 0755 deploy/glowtape-backup /usr/local/bin/glowtape-backup
systemctl daemon-reload
systemctl enable --now glowtape-push >/dev/null 2>&1 || true
systemctl restart glowtape glowtape-push
systemctl reload caddy
echo "Updated to $(git rev-parse --short HEAD) and restarted."
