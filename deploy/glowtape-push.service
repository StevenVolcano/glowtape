[Unit]
Description=Glow Tape web-push sender (localhost sidecar)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=glowtape
Group=glowtape
WorkingDirectory=/opt/glowtape/deploy/push-sender
EnvironmentFile=-/etc/glowtape/env
ExecStart=/usr/bin/node server.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
