{
  "name": "glowtape",
  "private": true,
  "version": "0.1.0",
  "description": "Glow Tape — Grays Harbor's theater community. Production and rehearsal management for community theater.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "backend": "cd backend && ./pocketbase serve --dev",
    "setup-backend": "bash scripts/get-pocketbase.sh"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "pocketbase": "^0.26.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "~5.8.0",
    "vite": "^6.3.0"
  }
}
